APP_NAME=Enterprise RAG Pipeline
APP_VERSION=1.0.0
DEBUG=True

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

SECRET_KEY=super-secret-enterprise-rag-key-change-in-production-2026!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_DIR=data/uploads
MAX_FILE_SIZE=52428800

DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/enterprise_rag
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/enterprise_rag

REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_documents
EMBEDDING_DIMENSION=384

ELASTICSEARCH_URL=http://localhost:9200
ELASTIC_INDEX=enterprise_documents

MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-large
ENABLE_RERANKER=false
RERANKER_MAX_CANDIDATES=6
MAX_RETRIEVAL_RESULTS=5
SEARCH_CONNECT_TIMEOUT_SECONDS=0.5

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

TEMPERATURE=0.2
TOP_P=0.95
MAX_OUTPUT_TOKENS=2048
MAX_RETRIES=3

LLM_CODEGEN_MODEL_PROVIDER=groq
LLM_CODEGEN_MODEL=qwen2.5-coder-32b-instruct
LLM_CODEGEN_TEMPERATURE=0.1

DUCKDB_PATH=data/duckdb
