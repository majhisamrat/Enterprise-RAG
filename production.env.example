# ============================================================================
# PRODUCTION ENVIRONMENT VARIABLES - Enterprise RAG
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in all values before deployment
# Never commit .env to version control!
# ============================================================================

# Application Settings
APP_NAME=Atlas Enterprise RAG
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security - CHANGE THESE VALUES IN PRODUCTION
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=enterprise_rag
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
SYNC_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_documents
EMBEDDING_DIMENSION=384

# File Upload Configuration
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE=52428800

# LLM Provider Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# LLM Parameters
TEMPERATURE=0.2
TOP_P=0.95
MAX_OUTPUT_TOKENS=2048
MAX_RETRIES=3

# Embedding Model Configuration
MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-large
ENABLE_RERANKER=false
RERANKER_MAX_CANDIDATES=6
MAX_RETRIEVAL_RESULTS=5
SEARCH_CONNECT_TIMEOUT_SECONDS=0.5

# ============================================================================
# OAuth Configuration (if enabled)
# ============================================================================
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/auth/callback/google

# ============================================================================
# Email Configuration (for notifications)
# ============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@your-domain.com

# ============================================================================
# Monitoring and Logging
# ============================================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# ENABLE_METRICS=true
# PROMETHEUS_ENABLED=true

# ============================================================================
# Docker Compose - Service Hostnames
# ============================================================================
# These should match the service names in docker-compose.yml
POSTGRES_HOST=postgres
REDIS_HOST=redis
QDRANT_HOST=qdrant
BACKEND_HOST=backend
FRONTEND_HOST=frontend
NGINX_HOST=nginx
